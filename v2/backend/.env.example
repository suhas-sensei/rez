# Hyperliquid Testnet Configuration
HYPERLIQUID_PRIVATE_KEY=your_private_key_here
HYPERLIQUID_WALLET_ADDRESS=0x_your_wallet_address
HYPERLIQUID_TESTNET=true

# Master Wallet (for auto-funding new users with testnet tokens)
MASTER_WALLET_PRIVATE_KEY=your_master_wallet_private_key
MASTER_WALLET_ADDRESS=0x_master_wallet_address
DEFAULT_FUNDING_AMOUNT=100.0
MAX_FUNDING_PER_USER=500.0

# LLM Configuration (OpenAI, Ollama, or OpenRouter)
LLM_API_KEY=your_openai_or_openrouter_key
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini

# TAAPI for technical indicators
TAAPI_API_KEY=your_taapi_key

# Trading Settings
DEFAULT_RISK_PROFILE=medium
TRADING_INTERVAL_SECONDS=60

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]

# Privy Authentication
PRIVY_APP_ID=your_privy_app_id
PRIVY_APP_SECRET=your_privy_app_secret
